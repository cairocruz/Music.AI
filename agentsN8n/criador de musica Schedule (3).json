      "parameters": {
        "jsonSchemaExample": "{\n  \"customMode\": true,\n  \"instrumental\": false,\n  \"model\": \"V4_5ALL\",\n  \"callBackUrl\": \"https://api.example.com/callback\",\n  \"prompt\": \"[Intro]\\nClau-Tech!\\nAbrindo o portal... dois mil e vinte e seis.\\nVersão 6G, atualizada.\\n\\n[Verse 1]\\nO cinco G ficou no passado, a rede agora voa\\nMeu beijo é pixelado, mas a química é boa\\nO grave bateu no peito, fez o download da emoção\\nNão tem firewall que segure essa pressão\\n\\n[Pre-Chorus]\\nO algoritmo já sabe, não tem como negar\\nÉ velocidade luz pra gente se conectar\\nVapo, vapo\\nCarregando o sistema...\\nSolta o grave do problema!\\n\\n[Chorus]\\nÉ o Paredão Seis G, velocidade máxima\\nA poeira sobe e vira nuvem de fumaça\\nTu tá hackeado, preso no meu loop\\nClauTech no comando, vem curtir o grupo\\nTuru-turu-turu digital\\n\\n[Bridge]\\nAgora desce, desce, no modo automático\\nAndroid, ciborgue, ou menino prático\\nTrava, destrava, reinicia e vai\\nNo passinho do robô, o sistema cai\\n\\n[Outro]\\nAtualização concluída.\\nClauTech.\\nA nova era.\\nDeslogando.\",\n  \"style\": \"Piseiro, Brazilian Funk, Tech Pop, Electronic, Teclado, Synthesizer, Futurism, Danceable, Female Vocals, Upbeat, 160 BPM\",\n  \"title\": \"Paredão 7G\",\n  \"personaId\": \"clautech_main_v1\",\n  \"negativeTags\": \"Acoustic, Slow, Jazz, Rock, Male Vocals, Ballad, Lo-fi, Melancholic\",\n  \"vocalGender\": \"f\",\n  \"styleWeight\": 0.8,\n  \"weirdnessConstraint\": 0.4,\n  \"audioWeight\": 0.6\n}"
