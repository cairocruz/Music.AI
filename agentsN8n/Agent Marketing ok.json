      "parameters": {
        "jsCode": "// Percorre todos os itens que chegaram no nó\nreturn items.map(item => {\n  const data = item.json;\n\n  // 1. TRATAR O \"3 MB\" -> Converter para Bytes numéricos\n  if (typeof data.total_bytes === 'string') {\n    // Pega apenas o número (ex: \"3\")\n    let valor = parseFloat(data.total_bytes);\n    \n    // Verifica a unidade e multiplica\n    if (data.total_bytes.toUpperCase().includes('MB')) {\n      // 1 MB = 1024 * 1024 bytes\n      data.total_bytes = Math.floor(valor * 1024 * 1024);\n    } else if (data.total_bytes.toUpperCase().includes('KB')) {\n      // 1 KB = 1024 bytes\n      data.total_bytes = Math.floor(valor * 1024);\n    }\n  }\n\n  // 2. CORRIGIR O ACENTO (vídeo -> video)\n  if (data.media_type && data.media_type.includes('vídeo')) {\n    data.media_type = data.media_type.replace('vídeo', 'video');\n  }\n  \n  // Retorna o item corrigido\n  return item;\n});"
      },
